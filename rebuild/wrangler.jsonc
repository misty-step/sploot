{
  "name": "sploot-rebuild",
  "main": "local-entry.mjs",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_AUD": "sploot-rebuild-preview",
    "ACCESS_ISS": "https://example.cloudflareaccess.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sploot-rebuild-preview",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sploot-rebuild-preview"
    }
  ]
}
