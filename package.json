{
  "name": "sploot-monorepo",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.1": "0.6.1",
      "brace-expansion@<1.1.21": "1.1.21",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "handlebars@<4.7.10": "4.7.10",
      "js-yaml@<4.3.2": "4.3.2",
      "postcss@<8.5.23": "8.5.23",
      "shell-quote@<1.11.0": "1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "tmp@<0.2.7": "0.2.7",
      "@types/react": "19.2.17",
      "undici@<6.28.1": "6.28.1",
      "undici@>=7.0.0 <7.29.1": "7.29.1",
      "uuid@<11.1.1": "11.1.1",
      "vite@>=8.0.0 <8.0.16": "8.0.16"
    }
  },
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "pnpm --filter server dev:local",
    "dev:server": "pnpm --filter server dev",
    "build:server": "pnpm --filter server build",
    "dev:extension": "turbo run dev --filter=extension",
    "build": "turbo run build",
    "lint": "pnpm stripe:sandbox:check && pnpm provider:check && pnpm provider:test && turbo run lint",
    "lint:design": "node scripts/check-design-system.mjs",
    "type-check": "turbo run type-check",
    "test:local": "pnpm --filter server smoke",
    "test": "turbo run test",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:gitleaks": "gitleaks dir --redact=100 --config .gitleaks.toml .",
    "secrets:test": "node --test scripts/check-secrets.test.mjs",
    "stripe:sandbox:check": "node scripts/check-stripe-sandbox.mjs",
    "provider:check": "node scripts/check-provider-retirement.mjs",
    "provider:test": "node --test scripts/check-provider-retirement.test.mjs",
    "telemetry:check": "node scripts/check-telemetry-inventory.mjs",
    "telemetry:test": "node --test scripts/check-telemetry-inventory.test.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/github": "^12.0.8",
    "semantic-release": "^25.0.9",
    "turbo": "^2.9.14"
  }
}
