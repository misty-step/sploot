{
  "name": "sploot-monorepo",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "overrides": {
      "handlebars": "4.7.9",
      "js-cookie": "3.0.7",
      "postcss@<8.5.10": "8.5.15",
      "serialize-javascript@<=7.0.2": "7.0.5",
      "shell-quote@<1.8.4": "1.8.4",
      "tmp@<0.2.6": "0.2.6",
      "@types/react": "19.2.17",
      "undici@<6.24.0": "6.24.0",
      "undici@>=7.0.0 <7.24.0": "7.24.0",
      "uuid@<11.1.1": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/darwin-arm64",
      "@ffmpeg-installer/darwin-x64",
      "@ffmpeg-installer/linux-arm",
      "@ffmpeg-installer/linux-arm64",
      "@ffmpeg-installer/linux-ia32",
      "@ffmpeg-installer/linux-x64"
    ]
  },
  "scripts": {
    "dev": "PORT=${PORT:-3001} VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://localhost:3001} turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:local": "pnpm --filter web dev:local",
    "dev:local:down": "pnpm --filter web dev:local:down",
    "dev:extension": "turbo run dev --filter=extension",
    "build": "turbo run build",
    "lint": "pnpm stripe:sandbox:check && pnpm provider:check && pnpm provider:test && turbo run lint",
    "lint:design": "node scripts/check-design-system.mjs",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "economics": "node economics/cost-model.mjs",
    "test:economics": "node --test economics/cost-model.test.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "secrets:gitleaks": "gitleaks dir --redact=100 --config .gitleaks.toml .",
    "secrets:test": "node --test scripts/check-secrets.test.mjs",
    "stripe:sandbox:check": "node scripts/check-stripe-sandbox.mjs",
    "provider:check": "node scripts/check-provider-retirement.mjs",
    "provider:test": "node --test scripts/check-provider-retirement.test.mjs",
    "telemetry:check": "node scripts/check-telemetry-inventory.mjs",
    "telemetry:test": "node --test scripts/check-telemetry-inventory.test.mjs",
    "deployment:check": "node scripts/check-web-deployment-runtime.mjs",
    "deployment:build": "node scripts/build-web-without-runtime-secrets.mjs",
    "deployment:test": "node --test scripts/check-web-deployment-runtime.test.mjs scripts/smoke-deployed-redirect.test.mjs scripts/check-migration-history.test.mjs",
    "ci:public-truth": "SPLOOT_DEPLOYMENT_ENV=test SPLOOT_ENROLLMENT_MODE=closed SPLOOT_PUBLIC_TRUTH_E2E_BUILD=true pnpm --filter web e2e:public-truth:build && SPLOOT_DEPLOYMENT_ENV=test SPLOOT_ENROLLMENT_MODE=closed SPLOOT_PUBLIC_TRUTH_E2E_BUILD=true pnpm --filter web e2e:public-truth",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/github": "^12.0.8",
    "semantic-release": "^25.0.3",
    "turbo": "^2.9.14"
  }
}
