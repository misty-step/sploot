name: example-gradient-profile
version: 0.1.0

harness:
  implementation: spellbook
  profile: base
  providers:
    - openai
    - anthropic
  default_model: gpt-5.4
  skills:
    - shape
    - implement
    - code-review
    - qa
    - pr-polish

work:
  implementation: orbital
  aliases:
    - teams-docs-bot
  adapter: orbital-mcp

fleet:
  implementation: olympus
  backend: olympus
  mode: supervised

policy:
  autonomy: supervised
  evidence:
    trace_backend: local
    retention: public-safe
  evidence_required:
    - tests
    - review-map
    - verification-commands
  feedback_destination: ./feedback.ndjson

context:
  sources:
    - kind: repo
      path: .
    - kind: docs
      path: ./docs
  retrieval:
    mode: assist
    citations: required
