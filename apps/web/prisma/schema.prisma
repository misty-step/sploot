// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// User model - synced with Clerk
model User {
  id        String   @id // Matches Clerk userId
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assets                   Asset[]
  tags                     Tag[]
  identities               UserIdentity[]
  storageQuota             UserStorageQuota?
  storageQuotaReservations StorageQuotaReservation[]
  uploadTokens             UploadToken[]
  uploadIdempotency        UploadIdempotency[]
  searchLogs               SearchLog[]
  embeddingRateLeases      EmbeddingRateLease[]
  libraryExports           LibraryExport[]

  @@map("users")
}

// UploadToken model - hashed, revocable, upload-only personal access tokens.
// Lets a non-session client (Apple Shortcut, CLI) authenticate upload-only API
// calls. Only the sha256 of the token is stored; the plaintext is shown once at
// mint time. See lib/auth/upload-token.ts.
model UploadToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String // Non-secret display prefix, e.g. "splt_ab12cd"
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("upload_tokens")
}

model UserIdentity {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  provider        String
  providerSubject String   @map("provider_subject")
  email           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject], name: "unique_provider_subject")
  @@index([userId])
  @@map("user_identities")
}

model UserStorageQuota {
  userId     String   @id @map("user_id")
  limitBytes BigInt   @default(1073741824) @map("limit_bytes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_storage_quotas")
}

model StorageQuotaReservation {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id")
  bytes       BigInt
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, expiresAt])
  @@map("storage_quota_reservations")
}

// Asset model - represents uploaded images
model Asset {
  id             String    @id @default(cuid()) // max 128 chars (migration CHECK)
  ownerUserId    String    @map("owner_user_id")
  blobUrl        String    @map("blob_url") // Validated via CHECK constraint: https://[a-z0-9-]+.public.blob.vercel-storage.com/*
  thumbnailUrl   String?   @map("thumbnail_url") // URL for 256px thumbnail. Validated via CHECK constraint if set
  pathname       String // Path in blob storage
  thumbnailPath  String?   @map("thumbnail_path") // Path for thumbnail in blob storage
  storageProvider          String  @default("vercel") @map("storage_provider")
  storageKey               String? @map("storage_key")
  storageSourceKey         String? @map("storage_source_key")
  thumbnailStorageKey      String? @map("thumbnail_storage_key")
  thumbnailStorageSourceKey String? @map("thumbnail_storage_source_key")
  storageConfigFingerprint String? @map("storage_config_fingerprint")
  storageSize              Int?    @map("storage_size")
  storageSha256            String? @map("storage_sha256")
  thumbnailStorageSize     Int?    @map("thumbnail_storage_size")
  thumbnailStorageSha256   String? @map("thumbnail_storage_sha256")
  mime           String
  width          Int?
  height         Int?
  size           Int // File size in bytes
  checksumSha256 String    @map("checksum_sha256")
  phash          String? // Perceptual hash for near-duplicate detection
  favorite       Boolean   @default(false)
  shuffleKey     BigInt    @default(dbgenerated("floor((random() * 9223372036854775807::double precision))::bigint")) @map("shuffle_key")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")
  shareSlug      String?   @unique @map("share_slug") // Short ID for public sharing URLs

  // Relations
  owner     User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  embedding AssetEmbedding?
  tags      AssetTag[]
  storageReplicas AssetStorageReplica[]

  // Indexes
  @@unique([ownerUserId, checksumSha256], name: "unique_user_checksum")
  @@index([ownerUserId, deletedAt])
  @@index([createdAt])
  @@index([favorite])
  @@index([shareSlug])
  @@map("assets")
}

// Durable boundary for retries after a client tab or request crashes. The
// queue id is stable across stale-lease recovery, so a completed request can
// be replayed without re-running the vendor-costing ingestion pipeline.
model UploadIdempotency {
  id             String   @id @default(cuid())
  ownerUserId    String   @map("owner_user_id")
  key            String
  status         String   @default("processing")
  result         Json?
  leaseToken     String   @map("lease_token")
  leaseExpiresAt DateTime @map("lease_expires_at")
  retainedUntil  DateTime @map("retained_until")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, key], name: "upload_idempotency_owner_key")
  @@index([leaseExpiresAt])
  @@index([status, retainedUntil])
  @@index([status, leaseExpiresAt])
  @@map("upload_idempotency")
}

// AssetEmbedding model - stores vector embeddings for semantic search
model AssetEmbedding {
  assetId         String                 @id @map("asset_id")
  // Database triggers copy these visibility fields from assets. They are
  // nullable here only because Prisma's status upserts are trigger-owned;
  // the migration makes owner_user_id NOT NULL and rejects drift.
  ownerUserId     String?                @map("owner_user_id")
  assetDeletedAt  DateTime?              @map("asset_deleted_at")
  modelName       String                 @map("model_name")
  modelVersion    String                 @map("model_version")
  dim             Int // Embedding dimensions
  // Must match packages/common/src/embeddings.ts EMBEDDING_DIMENSION.
  imageEmbedding  Unsupported("vector(768)")? @map("image_embedding")
  status          String?                @default("pending") // pending, processing, ready, failed
  processingClaimToken String?           @map("processing_claim_token")
  error           String? // Error message if failed
  attemptCount    Int                    @default(0) @map("attempt_count")
  reviveCount     Int                    @default(0) @map("revive_count")
  nextAttemptAt   DateTime?              @map("next_attempt_at")
  terminalAt      DateTime?              @map("terminal_at") // Set when bounded retries are exhausted
  completedAt     DateTime?              @map("completedAt") // When embedding was completed
  embeddingVector Unsupported("vector")? @map("embeddingVector") // Alternative vector column
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // Indexes will be created in migration SQL for pgvector HNSW
  @@index([modelName, modelVersion])
  @@index([status, createdAt])
  @@map("asset_embeddings")
}

// Durable provider admission backoff shared by cron and explicit retries.
model EmbeddingProviderCircuit {
  key            String    @id
  failureCount   Int       @default(0) @map("failure_count")
  generation     Int       @default(0)
  openUntil      DateTime? @map("open_until")
  probeUntil     DateTime? @map("probe_until")
  probeGeneration Int?     @map("probe_generation")
  probeLeaseToken String?  @map("probe_lease_token")
  lastReason     String?   @map("last_reason")
  lastFailureAt  DateTime? @map("last_failure_at")
  lastAlertedAt  DateTime? @map("last_alerted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([openUntil], map: "embedding_provider_circuits_open_until_idx")
  @@map("embedding_provider_circuits")
}

// Tag model - user-defined tags for organization
model Tag {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id")
  name        String // max 128 chars (migration CHECK)
  color       String? // max 32 chars (migration CHECK) // Hex color for UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner  User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  assets AssetTag[]

  // Indexes
  @@unique([ownerUserId, name], name: "unique_user_tag")
  @@index([ownerUserId])
  @@map("tags")
}

// AssetTag model - many-to-many relationship between assets and tags
model AssetTag {
  assetId   String   @map("asset_id")
  tagId     String   @map("tag_id")
  createdAt DateTime @default(now())

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // Composite primary key
  @@id([assetId, tagId])
  @@index([tagId])
  @@map("asset_tags")
}

// LibraryExport model - one resumable complete-library export session.
// The snapshot is recomputable (frozen predicate over snapshot_at), so only
// bookkeeping lives here: deterministic part boundaries, which parts were
// fully served, per-part object failures, and the egress spent. At most one
// 'active' row per user (partial unique index in migration SQL).
model LibraryExport {
  id                 String   @id @default(cuid())
  ownerUserId        String   @map("owner_user_id")
  status             String   @default("active") // active | complete | superseded | canceled
  snapshotAt         DateTime @map("snapshot_at")
  expiresAt          DateTime @map("expires_at")
  manifestVersion    String   @map("manifest_version")
  totalAssets        Int      @map("total_assets")
  totalOriginalBytes BigInt   @map("total_original_bytes")
  partBoundaries     Json     @map("part_boundaries") // bounded array: max 10,000 [{index, afterId, count, bytes}]
  servedParts        Json     @default("[]") @map("served_parts") // number[]
  failures           Json     @default("{}") // {"<partIndex>": [{assetId, archivePath, reason}]}
  egressBytes        BigInt   @default(0) @map("egress_bytes")
  manifestMetadataBytes BigInt @default(0) @map("manifest_metadata_bytes")
  createdAt          DateTime @default(now()) @map("created_at")
  manifestFinalizedAt DateTime? @map("manifest_finalized_at")
  manifestFinalizedSummary Json? @map("manifest_finalized_summary")
  manifestFinalizedArtifact String? @db.Text @map("manifest_finalized_artifact")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status])
  @@index([expiresAt])
  @@map("library_exports")
}

// Search log model - for analytics and improving search
model SearchLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  query       String
  resultCount Int      @map("result_count")
  queryTime   Int      @map("query_time") // milliseconds
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("search_logs")
}

// Persistent text-embedding cache - survives serverless instance churn so
// repeat searches skip the Replicate round-trip (in-memory cache is L1).
model TextEmbeddingCache {
  key       String   @id
  model     String
  embedding Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("text_embedding_cache")
}

// Durable counters for embedding minute windows and UTC daily/monthly attempt
// ceilings derived from the provider-rate model. These are not dollar ledgers.
// Expired rows are pruned while holding the limiter advisory lock.
model EmbeddingRateBucket {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("embedding_rate_buckets")
}

// Durable per-account daily/monthly counters for the cost admission kernel
// (apps/web/lib/cost/). Generalizes the EmbeddingRateBucket pattern to any
// capability key so image-indexing and novel-query inference spend are
// tracked -- and budgeted -- separately per account. Not a dollar ledger;
// attempt counts only, mutated under the same
// pg_advisory_xact_lock-per-transaction idiom as EmbeddingRateBucket.
model CostAdmissionCounter {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("cost_admission_counters")
}

// One row per admitted embedding job. Explicit leases make release idempotent,
// while expiresAt recovers capacity when a worker dies before releasing it.
model EmbeddingRateLease {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("embedding_rate_leases")
}

// Append-only Stripe webhook provenance and durable cancellation monitoring.
// Alert delivery flags are operational state; event and audit rows are never
// updated or deleted by the repository-owned adapter.
model StripeCancellationEvent {
  eventId              String   @id @map("event_id")
  eventType            String   @map("event_type")
  createdEpoch         Int      @map("created_epoch")
  payloadDigest        String   @map("payload_digest")
  rawBodyDigest        String   @map("raw_body_digest")
  rawPayload           Json     @map("raw_payload")
  rawBodyCiphertext    Bytes    @map("raw_body_ciphertext")
  rawBodyNonce         Bytes    @map("raw_body_nonce")
  rawBodyKeyId         String   @map("raw_body_key_id")
  signatureHeaderDigest String  @map("signature_header_digest")
  livemode             Boolean
  accountId            String?  @map("account_id")
  objectId             String   @map("object_id")
  objectType           String   @map("object_type")
  signatureTimestamp   Int      @map("signature_timestamp")
  receivedAt           DateTime @default(now()) @map("received_at")

  @@index([createdEpoch])
  @@map("stripe_cancellation_events")
}

model StripeCancellationAlert {
  alertKey       String   @id @map("alert_key")
  windowStart    Int      @map("window_start")
  windowSeconds  Int      @map("window_seconds")
  count          Int
  eventIds       Json     @map("event_ids")
  circuitOpened  Boolean  @default(false) @map("circuit_opened")
  pageSent       Boolean  @default(false) @map("page_sent")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("stripe_cancellation_alerts")
}

model StripeCancellationAudit {
  id               String   @id @default(cuid())
  eventId          String?  @map("event_id")
  alertKey         String?  @map("alert_key")
  action           String
  provenanceDigest String   @map("provenance_digest")
  details          Json
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([eventId, createdAt])
  @@index([alertKey, createdAt])
  @@map("stripe_cancellation_audit")
}

// Transactional outbox rows. A claimed row is fenced by its token and lease;
// an expired claim becomes pending again without losing the stable delivery key.
model StripeCancellationDelivery {
  deliveryKey   String    @id @map("delivery_key")
  alertKey      String    @map("alert_key")
  adapter       String
  status        String    @default("pending")
  claimToken    String?   @map("claim_token")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  deliveredAt   DateTime? @map("delivered_at")
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  generation     Int       @default(0)
  deadLetteredAt DateTime? @map("dead_lettered_at")
  replayKey      String    @unique @map("replay_key")
  payloadDigest  String    @map("payload_digest")
  payloadVersion String    @map("payload_version")
  payload        Json      @map("payload")
  payloadBytes   String    @map("payload_bytes")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([alertKey, adapter])
  @@index([alertKey, status, leaseExpiresAt])
  @@map("stripe_cancellation_deliveries")
}

model StripeCancellationMaintenance {
  id                   String   @id
  actor                String
  reason               String
  rangeStart           DateTime? @map("range_start")
  rangeEnd             DateTime? @map("range_end")
  purgedCount          Int      @map("purged_count")
  purgedDigest         String   @map("purged_digest")
  previousRecordDigest String?  @map("previous_record_digest")
  recordDigest         String   @map("record_digest")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("stripe_cancellation_maintenance")
}

model StripeCancellationMaintenanceToken {
  tokenDigest   String    @id @map("token_digest")
  generation    Int
  actor         String
  purpose       String
  subjectKind   String    @map("subject_kind")
  subjectId     String    @map("subject_id")
  timeBasis     String    @map("time_basis")
  rangeStart    DateTime  @map("range_start")
  rangeEnd      DateTime  @map("range_end")
  legalMinimumSince DateTime @map("legal_minimum_since")
  issuedAt      DateTime  @map("issued_at")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")

  @@map("stripe_cancellation_maintenance_tokens")
}

// Durable provider-neutral migration receipt. Claims are leased so a dead
// worker can resume without allowing two workers to finish the same row.
model StorageMigrationEntry {
  id              String    @id @default(cuid())
  logicalKey      String    @unique @map("logical_key")
  rendition       String    @default("original")
  sourceProvider  String    @map("source_provider")
  sourceKey       String    @map("source_key")
  targetProvider  String    @map("target_provider")
  targetKey       String    @map("target_key")
  size            Int
  sha256          String
  contentType     String?   @map("content_type")
  status          String    @default("pending")
  attempts        Int       @default(0)
  leaseGeneration Int       @default(0) @map("lease_generation")
  workerId        String?   @map("worker_id")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  lastError       String?   @map("last_error")
  verifiedAt      DateTime? @map("verified_at")
  rolledBackAt    DateTime? @map("rolled_back_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, leaseExpiresAt, logicalKey])
  @@map("storage_migration_entries")
}

model AssetStorageReplica {
  id          String   @id @default(cuid())
  assetId     String   @map("asset_id")
  rendition   String
  provider    String
  sourceKey   String?  @map("source_key")
  logicalKey  String   @map("logical_key")
  deliveryUrl String   @map("delivery_url")
  size        Int
  sha256      String
  contentType String?  @map("content_type")
  generation  Int
  active      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([assetId, rendition, generation, provider])
  @@index([assetId, rendition, active])
  @@map("asset_storage_replicas")
}

model StorageCleanupOutbox {
  id          String   @id @default(cuid())
  assetId     String?  @map("asset_id")
  provider    String
  key         String
  url         String
  action      String
  status      String   @default("pending")
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  availableAt DateTime @default(now()) @map("available_at")
  claimOwner  String?   @map("claim_owner")
  claimToken  String?   @map("claim_token")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@index([status, availableAt])
  @@index([status, availableAt, claimOwner, claimToken])
  @@map("storage_cleanup_outbox")
}

model StorageCutoverState {
  id                  String    @id
  phase               String
  generation          Int       @default(0)
  providerFingerprint String    @map("provider_fingerprint")
  manifestSha256      String?   @map("manifest_sha256")
  verifiedAt          DateTime? @map("verified_at")
  rollbackAt          DateTime? @map("rollback_at")
  legacyDeleteAfter   DateTime? @map("legacy_delete_after")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("storage_cutover_state")
}


model StorageInventoryState {
  id                  String   @id
  cursor              String?
  providerFingerprint String   @map("provider_fingerprint")
  lastError           String?  @map("last_error")
  updatedAt           DateTime @map("updated_at")
  @@map("storage_inventory_state")
}

model StorageInventoryFailure {
  assetId   String   @map("asset_id")
  kind      String
  error     String
  attempts  Int      @default(1)
  updatedAt DateTime @map("updated_at")
  @@id([assetId, kind])
  @@map("storage_inventory_failures")
}
