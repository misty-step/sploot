{
  "name": "web",
  "version": "0.1.0",
  "description": "Vercel-first meme library with text→image semantic search",
  "private": true,
  "scripts": {
    "dev": "PORT=${PORT:-3001} next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true",
    "postinstall": "prisma generate",
    "secrets:check": "gitleaks detect --verbose",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-og": "node scripts/generate-og-image.js",
    "generate-assets": "pnpm run generate-icons && pnpm run generate-og",
    "benchmark": "ts-node scripts/benchmark.ts",
    "benchmark:large": "ts-node scripts/benchmark.ts 10000",
    "gc:blobs": "tsx scripts/garbage-collect-blobs.ts",
    "gc:blobs:delete": "tsx scripts/garbage-collect-blobs.ts --delete",
    "validate:deployment": "bash scripts/validate-deployment.sh",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "validate:env": "tsx scripts/validate-env.ts",
    "db:sync": "./scripts/db-sync-env.sh",
    "db:fingerprint": "./scripts/db-fingerprint.sh",
    "db:drift": "./scripts/db-drift-check.sh"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.4",
    "@clerk/nextjs": "^6.39.4",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.54.0",
    "@sploot/common": "workspace:*",
    "@tanstack/react-virtual": "^3.13.26",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^1.1.1",
    "@vercel/functions": "^3.6.0",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lru-cache": "^11.5.0",
    "lucide-react": "^0.546.0",
    "nanoid": "^5.1.11",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-masonry-css": "^1.0.16",
    "replicate": "^1.4.0",
    "sanitize-html": "^2.17.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^15.5.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.8",
    "pg": "^8.21.0",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "webpack": "^5.107.2"
  },
  "packageManager": "pnpm@10.22.0"
}
