{
  "name": "web",
  "version": "0.1.0",
  "description": "DigitalOcean-hosted meme library with text→image semantic search",
  "private": true,
  "scripts": {
    "dev": "PORT=${PORT:-3001} next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . && pnpm auth:guard",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "e2e:auth": "playwright test --config playwright.config.ts --project=auth",
    "qa:gallery": "node scripts/qa-gallery-gate.mjs",
    "qa:seed": "tsx scripts/qa-seed.ts",
    "eval:fixtures": "tsx scripts/eval-build-fixtures.ts",
    "eval:search": "tsx scripts/eval-search.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:local:down": "tsx scripts/dev-local.ts --down",
    "qa:evidence": "tsx scripts/qa-evidence.ts",
    "stripe:recreate": "tsx scripts/stripe-recreate-subscriptions.ts",
    "auth:guard": "node scripts/check-auth-boundary.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-deploy.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true",
    "postinstall": "prisma generate",
    "secrets:check": "gitleaks detect --verbose",
    "generate-icons": "node scripts/generate-icons.js",
    "validate:pwa": "node scripts/validate-pwa-assets.mjs",
    "generate-og": "node scripts/generate-og-image.js",
    "generate-assets": "pnpm run generate-icons && pnpm run generate-og",
    "capture:pwa-screenshots": "tsx scripts/capture-pwa-screenshots.ts",
    "benchmark": "ts-node scripts/benchmark.ts",
    "benchmark:large": "ts-node scripts/benchmark.ts 10000",
    "validate:deployment": "bash scripts/validate-deployment.sh",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "validate:env": "tsx scripts/validate-env.ts",
    "enrollment:status": "tsx scripts/enrollment-status.ts",
    "probe:enrollment": "node scripts/probe-enrollment.mjs",
    "enrollment:lifecycle": "node scripts/enrollment-lifecycle.mjs",
    "db:fingerprint": "./scripts/db-fingerprint.sh",
    "db:drift": "./scripts/db-drift-check.sh",
    "storage:portability": "tsx scripts/storage-portability.ts",
    "e2e:queue": "PLAYWRIGHT_PROJECT=queue playwright test --config playwright.config.ts --project=queue",
    "e2e:portable-telemetry": "PLAYWRIGHT_PROJECT=portable-telemetry playwright test --config playwright.config.ts --project=portable-telemetry",
    "e2e:public-truth": "playwright test --config playwright.config.ts --project=public-truth --grep \"public truth\"",
    "e2e:public-truth:build": "node scripts/build-public-truth.mjs",
    "e2e:public-truth:production-guard": "node scripts/verify-production-public-truth-guard.mjs",
    "e2e:public-truth:serve": "node scripts/serve-public-truth.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.4",
    "@clerk/nextjs": "^6.39.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@misty-step/aesthetic": "github:misty-step/aesthetic#v0.25.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sploot/common": "workspace:*",
    "@tanstack/react-virtual": "^3.13.26",
    "@vercel/blob": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "lru-cache": "^11.5.0",
    "lucide-react": "^0.546.0",
    "nanoid": "^5.1.11",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-masonry-css": "^1.0.16",
    "replicate": "^1.4.0",
    "sanitize-html": "^2.17.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@next/bundle-analyzer": "16.2.10",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.8",
    "pg": "^8.21.0",
    "prisma": "^6.19.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "yaml": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "webpack": "^5.107.2"
  },
  "packageManager": "pnpm@10.22.0"
}
