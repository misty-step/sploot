# Sploot Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Clerk has separate instances for Development and Production:
#
# DEVELOPMENT/PREVIEW (localhost, preview deployments):
#   - Use pk_test_* and sk_test_* keys from your Development instance
#   - Domain: tender-bison-73.clerk.accounts.dev
#   - These keys are set in .env.local or an isolated preview environment
#
# PRODUCTION (www.sploot.app):
#   - Use pk_live_* and sk_live_* keys from your Production instance
#   - Domain: clerk.sploot.app
#   - These keys are set in the production deployment environment
#
# Get these from https://clerk.com > Configure > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Optional dedicated HMAC authority for signed search cursors. If omitted,
# CLERK_SECRET_KEY is used in Clerk-backed deployments and the QA signing
# secret is used only by the isolated signed QA seam.
SEARCH_CURSOR_SECRET=

# Clerk redirect URLs (already configured)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app

# Comma-separated origins Clerk should accept for cookie/bearer auth.
# Include every active Chrome extension origin used by local, staging, and prod builds.
CLERK_AUTHORIZED_PARTIES=https://sploot.app,https://www.sploot.app,http://localhost:3000,http://localhost:3001,chrome-extension://ipnlamdcakhmbidjlpoinkgimfapejna

# ============================================
# DATABASE (Required)
# ============================================
# Get this from the Neon project after creating the Postgres database
# IMPORTANT: Use the pooler endpoint (hostname ending in -pooler) with pgbouncer=true
# Example: postgresql://user:pass@host-pooler.neon.tech/db?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/database?sslmode=require&pgbouncer=true

# Direct (non-pooled) connection for LISTEN/NOTIFY operations
# Required only if using PgNotifyListener for real-time notifications
# IMPORTANT: Use direct endpoint WITHOUT -pooler in hostname, NO pgbouncer=true parameter
# LISTEN/NOTIFY is incompatible with PgBouncer transaction pooling
# Example: postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host.neon.tech/database?sslmode=require

# ============================================
# STORAGE (Required)
# ============================================
# Get this from the Vercel Blob store credentials
BLOB_READ_WRITE_TOKEN=vercel_blob_your_token_here

# ============================================
# AI EMBEDDINGS (Required for search)
# ============================================
# Get this from https://replicate.com
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ============================================
# DEVELOPMENT OPTIONS
# ============================================
# Credential-free local loop (local pgvector Postgres + qa-local auth +
# seeded assets): run `pnpm dev:local` from the repo root instead of setting
# the vendor variables above. See docs/AUTH.md.

# Port for development server (default: 3000)
PORT=3000

# ============================================
# MONITORING (Optional)
# ============================================
DEPLOYMENT_ENV=development
# browser telemetry is same-origin by default; only a relative path is allowed
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry
NEXT_PUBLIC_TELEMETRY_ENABLED=true

# ============================================
# PRE-GA ENROLLMENT CONTAINMENT (Required in production)
# ============================================
# Use `ga` only for the explicit GA lift after the remaining release gates
# are complete. `closed` is an intentional pause. Production fails closed for
# new accounts when these values are missing or malformed.
SPLOOT_ENROLLMENT_MODE=capped
SPLOOT_ENROLLMENT_MAX_ACCOUNTS=100
SPLOOT_DEPLOYMENT_ENV=development
SPLOOT_DEPLOYMENT_APP_ID=
SPLOOT_DEPLOYMENT_COMMIT=
# App Platform resolves SPLOOT_DEPLOYMENT_APP_ID from ${APP_ID} and
# SPLOOT_DEPLOYMENT_COMMIT from ${_self.COMMIT_HASH}; this is an immutable
# operator-generated lifecycle change ID, not a provider deployment ID.
SPLOOT_DEPLOYMENT_CHANGE_ID=

CANARY_ENDPOINT=https://canary.mistystep.io
CANARY_API_KEY=your_canary_ingest_key_here
CANARY_SERVICE_NAME=sploot-web
