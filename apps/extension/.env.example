# Chrome Extension CRX ID (run 'pnpm generate:crx-key' to auto-generate)
CRX_PUBLIC_KEY=

# Clerk Configuration (local/test instance)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional API base override (defaults to sploot.app in prod, localhost in dev)
# VITE_API_BASE_URL=http://localhost:3001

# For production builds create .env.production with:
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
