# Chrome Extension CRX ID (run 'pnpm generate:crx-key' to auto-generate)
CRX_PUBLIC_KEY=

# Clerk Configuration (local/test instance)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_SYNC_HOST=http://localhost:3001
CLERK_SECRET_KEY=sk_test_...

# Optional API base override (defaults to sploot.app in prod, localhost in dev)
# VITE_API_BASE_URL=http://localhost:3001

# Also add this extension origin to the web app's CLERK_AUTHORIZED_PARTIES:
# chrome-extension://<generated-extension-id>

# For production builds create .env.production with:
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# VITE_CLERK_SYNC_HOST=https://clerk.sploot.app
# VITE_API_BASE_URL=https://sploot.app
# CLERK_SECRET_KEY=sk_live_...
