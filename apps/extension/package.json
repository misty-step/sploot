{
  "name": "extension",
  "version": "1.0.0",
  "description": "Chrome extension for saving memes to Sploot",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "WXT_MODE=development wxt build",
    "build:manifest-check": "WXT_MODE=manifest-check wxt build",
    "build:prod": "WXT_MODE=production wxt build",
    "build:prod:unpacked": "INCLUDE_CRX_KEY=true WXT_MODE=production wxt build",
    "build:e2e": "WXT_MODE=development wxt build",
    "build:firefox": "WXT_MODE=development wxt build -b firefox",
    "release:check": "node scripts/validate-store-release.mjs",
    "release:structural": "RELEASE_STRUCTURAL_ONLY=true node scripts/validate-store-release.mjs",
    "release:test": "node --test scripts/release-provenance.node-test.mjs scripts/ci-extension-order.node-test.mjs",
    "release:verify-uploaded": "node scripts/verify-uploaded-artifact.mjs",
    "manifest:check": "node scripts/validate-manifest.mjs",
    "manifest:test": "node --test scripts/manifest-policy.node-test.mjs",
    "test:layout": "playwright test --config playwright.config.ts playwright/popup-layout.e2e.ts",
    "test:mv3:fixture": "playwright test --config playwright.config.ts playwright/mv3-api-fixture.e2e.ts",
    "test:mv3": "playwright test --config playwright.config.ts playwright/mv3-lifecycle.e2e.ts",
    "zip": "wxt zip",
    "zip:prod": "WXT_MODE=production node scripts/build-production-release.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "generate:crx-key": "bash scripts/generate-crx-key.sh",
    "generate:icons": "node scripts/generate-icons.js",
    "test:update-nag": "playwright test --config playwright.config.ts playwright/update-nag.e2e.ts",
    "assert:update-nag-artifact": "node scripts/assert-update-nag-artifact.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@sploot/common": "workspace:*"
  }
}
