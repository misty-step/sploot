# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files - catch in all directories
.env*
**/*.env
**/database.env
*.env.*

# secrets
*.key
**/secrets/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# swc
.swc

# PWA generated files
/public/sw.js
/public/sw.js.map
/public/workbox-*.js

/lib/generated/prisma

# Sentry
.sentryclirc
sentry.properties

# clerk configuration (can include secrets)
/.clerk/
